VITE_BASE_URL=http://localhost:4000

# Khoa Google Maps Platform DUNG CHO TRINH DUYET (Maps JavaScript API) - chi
# de ve "Xem bản đồ" tong hop nha so (xem lib/loadGoogleMaps.ts). Bat buoc phai
# han che theo HTTP referrer (domain admin) tren Google Cloud Console va CHI
# bat Maps JavaScript API - day la khoa DUY NHAT duoc phep lo ra trinh duyet,
# KHAC voi GOOGLE_MAPS_SERVER_API_KEY o backend (han che theo IP, dung cho
# Places/Geocoding/Static Maps qua proxy).
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
